{
  "manifest_version": 3,
  "name": "KiCad Part Finder",
  "version": "0.3.0",
  "description": "Find and install KiCad symbols, footprints, and 3D models from DigiKey and LCSC",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.digikey.com/*",
    "https://www.digikey.tw/*",
    "https://www.digikey.co.uk/*",
    "https://www.digikey.de/*",
    "https://www.digikey.jp/*",
    "https://www.digikey.cn/*",
    "https://www.digikey.com.au/*",
    "https://www.digikey.ca/*",
    "https://*.lcsc.com/*",
    "https://lcsc.com/*",
    "https://*.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.digikey.com/*/products/detail/*",
        "https://www.digikey.tw/*/products/detail/*",
        "https://www.digikey.co.uk/*/products/detail/*",
        "https://www.digikey.de/*/products/detail/*",
        "https://www.digikey.jp/*/products/detail/*",
        "https://www.digikey.cn/*/products/detail/*",
        "https://www.digikey.com.au/*/products/detail/*",
        "https://www.digikey.ca/*/products/detail/*"
      ],
      "js": [
        "content/digikey.js",
        "content/page-listener.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.lcsc.com/product-detail/*",
        "https://lcsc.com/product-detail/*"
      ],
      "js": [
        "content/lcsc.js",
        "content/page-listener.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "commands": {
    "open-finder": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Part Finder"
    },
    "search-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Search the highlighted text"
    },
    "install-current": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Install the part shown in Part Finder"
    }
  },
  "action": {
    "default_title": "KiCad Part Finder"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "comment": "The finder UI loaded as an <iframe> by the in-page overlay (and the v1 float). index.html is the framed page; the JS/CSS/three.js chunks are its sub-resources (same-origin to the framed extension doc, listed defensively so the framed 3D preview loads on any host page).",
      "resources": [
        "src/sidepanel/index.html",
        "sidepanel/sidepanel.js",
        "sidepanel/sidepanel.css",
        "chunks/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
